# Database connection for PostGIS (port 5433 by default in docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/weather_alert

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Redis connection for deduplication and BullMQ queue
REDIS_URL=redis://localhost:6380

# Meteogate api key
METEOGATE_API_KEY=your_key

# H3 cell resolution used for both stored locations and warning polygons
H3_RESOLUTION=6
