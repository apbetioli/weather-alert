# Database connection
# Note: In Docker Compose, the app container connects directly to `postgis:5432`.
# For local host development (outside Docker), use port 5433:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/weather_alert

# Optional: Custom DB credentials (defaults to postgres / postgres / weather_alert)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weather_alert

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Redis connection
# Note: In Docker Compose, the app container connects directly to `redis:6379`.
# For local host development (outside Docker), use port 6380:
REDIS_URL=redis://localhost:6380

# Bull Board Dashboard Configuration (port 3000 by default)
PORT=3000
HOST=0.0.0.0
# Optional Basic Auth credentials for /ui dashboard (leave DASHBOARD_PASSWORD empty to disable auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Meteogate api key
METEOGATE_API_KEY=your_key

# H3 cell resolution used for both stored locations and warning polygons
H3_RESOLUTION=6
